bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3", dev_dependency = True)
bazel_dep(name = "googletest", version = "1.18.0.bcr.1", dev_dependency = True)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.28")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "git_repository")

http_archive(
    name = "arm64_gcc_linux_x86_64",
    build_file = "//bazel/toolchains/arm/arm_gcc_linux_x86_64:compiler.BUILD",
    sha256 = "97dbb4f019ad1650b732faffcc881689cedc14e2b7ee863d390e0a41ef16c9a3",
    strip_prefix = "gcc-arm-none-eabi-10.3-2021.10",
    url = "https://developer.arm.com/-/media/Files/downloads/gnu-rm/10.3-2021.10/gcc-arm-none-eabi-10.3-2021.10-x86_64-linux.tar.bz2?rev=78196d3461ba4c9089a67b5f33edf82a&hash=5631ACEF1F8F237389F14B41566964EC",
)

git_repository(
    name = "bazel_embedded",
    commit = "d3cbe4eff9a63d3dee63067d61096d681daca33b",
    remote = "https://github.com/bazelembedded/bazel-embedded.git",
    shallow_since = "1585022166 +0800",
)

bazel_dep(name = "llvm", version = "0.8.27")

llvm = use_extension("@llvm//extensions:llvm.bzl", "llvm")
llvm.version(llvm_version = "22.1.0")
use_repo(llvm, "llvm-project")

toolchain = use_extension("@llvm//extensions:toolchain.bzl", "toolchain")
toolchain.exec(
    arch = "x86_64",
    os = "linux",
)
toolchain.exec(
    arch = "aarch64",
    os = "linux",
)
toolchain.target(
    arch = "x86_64",
    os = "linux",
)
toolchain.target(
    arch = "aarch64",
    os = "linux",
)
use_repo(toolchain, "llvm_toolchains")

register_toolchains("@llvm//toolchain:all")

# 1.2.0 is not on BCR, so use commit instead
bazel_dep(name = "toolchains_arm_gnu", version = "")

#git_override(
#    module_name = "toolchains_arm_gnu",
#    commit = "6895733b87d3a75a40056b12c3d6628bc6945011",
#    remote = "https://github.com/hexdae/toolchains_arm_gnu.git",
#)

local_path_override(
    module_name = "toolchains_arm_gnu",
    path = "../toolchains_arm_gnu",
)

arm_toolchain = use_extension("@toolchains_arm_gnu//:extensions.bzl", "arm_toolchain")
arm_toolchain.arm_none_eabi()
use_repo(arm_toolchain, "arm_none_eabi")

arm_toolchain.arm_none_linux_gnueabihf()
use_repo(arm_toolchain, "arm_none_linux_gnueabihf")

register_toolchains("@arm_none_linux_gnueabihf//toolchain:all")

arm_toolchain.aarch64_none_elf()
use_repo(arm_toolchain, "aarch64_none_elf")

register_toolchains("@aarch64_none_elf//toolchain:all")

arm_toolchain.aarch64_none_linux_gnu()
use_repo(arm_toolchain, "aarch64_none_linux_gnu")

register_toolchains("@aarch64_none_linux_gnu//toolchain:all")

register_toolchains(
    "//bazel/toolchains/arm:cortex_m4_toolchain",
)

bazel_dep(name = "tomlplusplus", version = "3.4.0.bcr.1")
